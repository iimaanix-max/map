<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Mobile Ads (AdMob) Ad Services configuration.
    Required by Android Privacy Sandbox / Topics API integration.
    Referenced in AndroidManifest.xml via @xml/gma_ad_services_config.
    DO NOT REMOVE — removing this file will cause runtime warnings and
    may affect ad fill rates on Android 13+ devices.
-->
<ad-services-config>
    <attribution>
        <allowed-packages-for-value-propagation>
            <package name="com.android.adservices.api"/>
            <package name="com.android.ext.adservices.api"/>
        </allowed-packages-for-value-propagation>
    </attribution>
    <topics allowAllToAccess="true"/>
    <custom-audiences allowAllToAccess="true"/>
    <protected-signals allowAllToAccess="true"/>
</ad-services-config>

