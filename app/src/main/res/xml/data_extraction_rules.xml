<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <!-- Exclude sensitive contact PII and precise GPS coordinates from cloud backup -->
        <exclude domain="sharedpref" path="dt_campaign_prefs.xml" />
        <exclude domain="sharedpref" path="dt_prayer_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
