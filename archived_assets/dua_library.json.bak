    "ar": "ضَعْ يَدَكَ عَلَى الَّذِي تَأَلَّمَ مِنْ جَسَدِكَ، وَقُلْ: بِسْمِ اللَّهِ ثَلَاثًا، ثُمَّ قُلْ سَبْعَ مَرَّاتٍ: أَعُوذُ بِاللَّهِ وَقُدْرَتِهِ مِنْ شَرِّ مَا أَجِدُ وَأُحَاذِرُ",
    "lo": {
      "en": "Place your hand on the area of pain and say 'Bismillah' three times, then recite seven times: A'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir.",
      "hi": "Place your hand on the area of pain and say 'Bismillah' three times, then recite seven times: A'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir.",
      "ur": "Place your hand on the area of pain and say 'Bismillah' three times, then recite seven times: A'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir."
    },
    "me": {
