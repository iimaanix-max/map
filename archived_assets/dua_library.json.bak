    "cat": "faith_worship",
    "subcat": "steadfastness_on_the_reli",
    "allCats": [
      "faith_worship",
      "heart"
    ],
    "ar": "أَشْهَدُ أَنْ لَا إِلٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ، اللَّهُمَّ اجْعَلْنِي مِنَ التَّوَّابِينَ وَاجْعَلْنِي مِنَ الْمُتَطَهِّرِينَ",
    "lo": {
      "en": "Ashhadu an la ilaha illallahu wahdahu la sharika lah, wa ashhadu anna Muhammadan abduhu wa rasuluh. Allahummaj'alni minat-tawwabin waj'alni minal-mutatahhirin.",
      "hi": "Ashhadu an la ilaha illallahu wahdahu la sharika lah, wa ashhadu anna Muhammadan abduhu wa rasuluh. Allahummaj'alni minat-tawwabin waj'alni minal-mutatahhirin.",
      "ur": "Ashhadu an la ilaha illallahu wahdahu la sharika lah, wa ashhadu anna Muhammadan abduhu wa rasuluh. Allahummaj'alni minat-tawwabin waj'alni minal-mutatahhirin."
    },
    "me": {
      "en": "I bear witness that none has the right to be worshipped except Allah alone, without partner, and I bear witness that Muhammad ﷺ is His servant and Messenger. O Allah, make me among those who constantly repent and among those who purify themselves.",
      "hi": "I bear witness that none has the right to be worshipped except Allah alone, without partner, and I bear witness that Muhammad ﷺ is His servant and Messenger. O Allah, make me among those who constantly repent and among those who purify themselves.",
      "ur": "I bear witness that none has the right to be worshipped except Allah alone, without partner, and I bear witness that Muhammad ﷺ is His servant and Messenger. O Allah, make me among those who constantly repent and among those who purify themselves."
    },
