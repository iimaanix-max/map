    "ar": "بِاسْمِكَ رَبِّي وَضَعْتُ جَنْبِي وَبِكَ أَرْفَعُهُ، إِنْ أَمْسَكْتَ نَفْسِي فَارْحَمْهَا، وَإِنْ أَرْسَلْتَهَا فَاحْفَظْهَا بِمَا تَحْفَظُ بِهِ عِبَادَكَ الصَّالِحِينَ",
    "lo": {
      "en": "Bismika Rabbi wada'tu janbi wa bika arfa'uh, in amsakta nafsi farhamha, wa in arsaltaha fahfazha bima tahfazu bihi 'ibadakas-salihin",
      "hi": "Bismika Rabbi wada'tu janbi wa bika arfa'uh, in amsakta nafsi farhamha, wa in arsaltaha fahfazha bima tahfazu bihi 'ibadakas-salihin",
      "ur": "Bismika Rabbi wada'tu janbi wa bika arfa'uh, in amsakta nafsi farhamha, wa in arsaltaha fahfazha bima tahfazu bihi 'ibadakas-salihin"
    },
    "me": {
      "en": "In Your name, my Lord, I lay my side down and by You I raise it up. If You take my soul, have mercy on it; and if You send it back, protect it as You protect Your righteous slaves.",
      "hi": "In Your name, my Lord, I lay my side down and by You I raise it up. If You take my soul, have mercy on it; and if You send it back, protect it as You protect Your righteous slaves.",
      "ur": "In Your name, my Lord, I lay my side down and by You I raise it up. If You take my soul, have mercy on it; and if You send it back, protect it as You protect Your righteous slaves."
    },
    "title": {
      "en": "Before Sleeping",
      "hi": "सोने से पहले की दुआ",
      "ur": "सोने से पहले की दुआ"
    },
    "tm": {
