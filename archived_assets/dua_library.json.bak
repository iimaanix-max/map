    "ar": "أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ غَضَبِهِ وَعِقَابِهِ، وَشَرِّ عِبَادِهِ، وَمِنْ هَمَزَاتِ الشَّيَاطِينِ وَأَنْ يَحْضُرُونِ",
    "lo": {
      "en": "A'udhu bi kalimatillahit-tammati min ghadabihi wa 'iqabihi wa sharri 'ibadihi wa min hamazatish-shayatini wa an yahdurun.",
      "hi": "A'udhu bi kalimatillahit-tammati min ghadabihi wa 'iqabihi wa sharri 'ibadihi wa min hamazatish-shayatini wa an yahdurun.",
      "ur": "A'udhu bi kalimatillahit-tammati min ghadabihi wa 'iqabihi wa sharri 'ibadihi wa min hamazatish-shayatini wa an yahdurun."
    },
    "me": {
      "en": "I seek refuge in the Perfect Words of Allah from His anger, His punishment, the evil of His servants, the whisperings of the devils and from their presence.",
      "hi": "I seek refuge in the Perfect Words of Allah from His anger, His punishment, the evil of His servants, the whisperings of the devils and from their presence.",
