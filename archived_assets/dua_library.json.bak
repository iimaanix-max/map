    "allCats": [
      "faith_worship",
      "heart"
    ],
    "ar": "اللَّهُمَّ اهْدِنِي لِأَحْسَنِ الْأَخْلَاقِ، لَا يَهْدِي لِأَحْسَنِهَا إِلَّا أَنْتَ، وَاصْرِفْ عَنِّي سَيِّئَهَا، لَا يَصْرِفُ عَنِّي سَيِّئَهَا إِلَّا أَنْتَ",
    "lo": {
      "en": "Allahumma ihdini li-ahsanil-akhlaq, la yahdi li-ahsaniha illa Anta, wasrif 'anni sayyi'aha, la yasrifu 'anni sayyi'aha illa Anta.",
      "hi": "Allahumma ihdini li-ahsanil-akhlaq, la yahdi li-ahsaniha illa Anta, wasrif 'anni sayyi'aha, la yasrifu 'anni sayyi'aha illa Anta.",
      "ur": "Allahumma ihdini li-ahsanil-akhlaq, la yahdi li-ahsaniha illa Anta, wasrif 'anni sayyi'aha, la yasrifu 'anni sayyi'aha illa Anta."
    },
    "me": {
      "en": "O Allah, guide me to the best of character, for none can guide to the best of it except You. Turn away from me bad character, for none can turn it away from me except You.",
