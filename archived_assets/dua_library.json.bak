      "mental_health",
      "hardship",
      "daily_life",
      "stress",
      "protection"
    ],
    "ar": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْهَمِّ وَالْحَزَنِ، وَالْعَجْزِ وَالْكَسَلِ، وَالْجُبْنِ وَالْبُخْلِ، وَضَلَعِ الدَّيْنِ، وَغَلَبَةِ الرِّجَالِ",
    "lo": {
      "en": "Allahumma inni a'udhu bika minal-hammi wal-hazan, wal-'ajzi wal-kasal, wal-jubni wal-bukhl, wa dala'id-dayni wa ghalabatir-rijal",
      "hi": "Allahumma inni a'udhu bika minal-hammi wal-hazan, wal-'ajzi wal-kasal, wal-jubni wal-bukhl, wa dala'id-dayni wa ghalabatir-rijal",
      "ur": "Allahumma inni a'udhu bika minal-hammi wal-hazan, wal-'ajzi wal-kasal, wal-jubni wal-bukhl, wa dala'id-dayni wa ghalabatir-rijal"
    },
    "me": {
      "en": "O Allah, I seek refuge in You from anxiety and sorrow, weakness and laziness, cowardice and miserliness, the burden of debt and being overpowered by men.",
      "hi": "O Allah, I seek refuge in You from anxiety and sorrow, weakness and laziness, cowardice and miserliness, the burden of debt and being overpowered by men.",
      "ur": "O Allah, I seek refuge in You from anxiety and sorrow, weakness and laziness, cowardice and miserliness, the burden of debt and being overpowered by men."
    },
    "title": {
      "en": "For Relief from Anxiety, Debt, and Inability",
      "hi": "चिंता, क़र्ज़ व लाचारी से पनाह की दुआ",
      "ur": "चिंता, क़र्ज़ व लाचारी से पनाह की दुआ"
    },
    "tm": {
      "en": "In the morning, in the evening, and after prayers.",
      "hi": "In the morning, in the evening, and after prayers.",
      "ur": "In the morning, in the evening, and after prayers."
    },
    "how": {
      "en": "Anas (RA) reported that the Prophet ﷺ used to recite this supplication very frequently. Virtue & Benefit: Comprehensive shield against the major mental, spiritual, and financial distresses of worldly life.",
      "hi": "Anas (RA) reported that the Prophet ﷺ used to recite this supplication very frequently. फ़ज़ीलत: Comprehensive shield against the major mental, spiritual, and financial distresses of worldly life.",
      "ur": "Anas (RA) reported that the Prophet ﷺ used to recite this supplication very frequently. فضیلت: Comprehensive shield against the major mental, spiritual, and financial distresses of worldly life."
    },
    "ref": "Sahih al-Bukhari (2893) | Sahih",
    "active": true
  },
  {
    "id": "dua_v_028",
