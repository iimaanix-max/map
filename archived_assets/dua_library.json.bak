    ],
    "ar": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ، وَمِنْ عَذَابِ جَهَنَّمَ، وَمِنْ فِتْنَةِ الْمَحْيَا وَالْمَمَاتِ، وَمِنْ شَرِّ فِتْنَةِ الْمَسِيحِ الدَّجَّالِ",
    "lo": {
      "en": "Allahumma inni a'udhu bika min 'adhabil-qabr, wa min 'adhabi Jahannam, wa min fitnatil-mahya wal-mamat, wa min sharri fitnatil-Masihid-Dajjal.",
      "hi": "Allahumma inni a'udhu bika min 'adhabil-qabr, wa min 'adhabi Jahannam, wa min fitnatil-mahya wal-mamat, wa min sharri fitnatil-Masihid-Dajjal.",
      "ur": "Allahumma inni a'udhu bika min 'adhabil-qabr, wa min 'adhabi Jahannam, wa min fitnatil-mahya wal-mamat, wa min sharri fitnatil-Masihid-Dajjal."
    },
    "me": {
      "en": "O Allah, I seek refuge in You from the punishment of the grave, the punishment of Hell, the trials of life and death, and the evil trial of the False Messiah (Dajjal).",
      "hi": "O Allah, I seek refuge in You from the punishment of the grave, the punishment of Hell, the trials of life and death, and the evil trial of the False Messiah (Dajjal).",
      "ur": "O Allah, I seek refuge in You from the punishment of the grave, the punishment of Hell, the trials of life and death, and the evil trial of the False Messiah (Dajjal)."
    },
    "title": {
      "en": "For the Deceased and Salvation in the Hereafter",
      "hi": "मय्यित की मग़फ़िरत व जनाज़े की दुआ",
      "ur": "मय्यित की मग़फ़िरत व जनाज़े की दुआ"
    },
    "tm": {
      "en": "Recite anytime with sincerity, especially during moments of supplication.",
      "hi": "दुआ मांगने के किसी भी मुबारक वक़्त में आजिज़ी से पढ़ें।",
      "ur": "دعا مانگنے کے کسی بھی مبارک وقت میں عاجزی سے پڑھیں۔"
    },
    "how": {
      "en": "Supplicate to Allah with sincerity, devotion, and firm conviction..",
      "hi": "आजिज़ी, तवज्जो और यक़ीन के साथ अल्लाह की बारगाह में दुआ मांगें।",
      "ur": "आजिज़ी, तवज्जो और यक़ीन के साथ अल्लाह की बारगाह में दुआ मांगें।"
    },
