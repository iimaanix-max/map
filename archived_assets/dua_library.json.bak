  {
    "id": "dua_v_063",
    "cat": "rain",
    "subcat": "when_hearing_thunder",
    "allCats": [
      "rain",
      "daily_life"
    ],
    "ar": "سُبْحَانَ الَّذِي يُسَبِّحُ الرَّعْدُ بِحَمْدِهِ وَالْمَلَائِكَةُ مِنْ خِيفَتِهِ",
    "lo": {
      "en": "Subhanal-ladhi yusabbihur-ra'du bi-hamdihi wal-mala'ikatu min khifatih",
      "hi": "Subhanal-ladhi yusabbihur-ra'du bi-hamdihi wal-mala'ikatu min khifatih",
      "ur": "Subhanal-ladhi yusabbihur-ra'du bi-hamdihi wal-mala'ikatu min khifatih"
    },
    "me": {
      "en": "Glory be to Him whom the thunder glorifies with His praise, and the angels from the fear of Him.",
      "hi": "Glory be to Him whom the thunder glorifies with His praise, and the angels from the fear of Him.",
      "ur": "Glory be to Him whom the thunder glorifies with His praise, and the angels from the fear of Him."
    },
    "title": {
      "en": "When Hearing Thunder",
      "hi": "बिजली कड़कने और बादल गरजने पर दुआ",
      "ur": "बिजली कड़कने और बादल गरजने पर दुआ"
    },
    "tm": {
      "en": "Upon hearing thunder.",
      "hi": "Upon hearing thunder.",
      "ur": "Upon hearing thunder."
    },
    "how": {
      "en": "Count: 1 time.  Abdullah ibn az-Zubayr (RA) would stop speaking whenever he heard thunder and recite this. Virtue & Benefit: Aligns human glorification with the cosmic glorification of the angels and natural elements.",
      "hi": "तादाद: 1 time। Abdullah ibn az-Zubayr (RA) would stop speaking whenever he heard thunder and recite this. फ़ज़ीलत: Aligns human glorification with the cosmic glorification of the angels and natural elements.",
      "ur": "تعداد: 1 time। Abdullah ibn az-Zubayr (RA) would stop speaking whenever he heard thunder and recite this. فضیلت: Aligns human glorification with the cosmic glorification of the angels and natural elements."
    },
