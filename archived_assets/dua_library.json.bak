  {
    "id": "dua_v_030",
    "cat": "rizq",
    "subcat": "for_debt_relief_and_freed",
    "allCats": [
      "rizq"
    ],
    "ar": "اللَّهُمَّ اكْفِنِي بِحَلَالِكَ عَنْ حَرَامِكَ، وَأَغْنِنِي بِفَضْلِكَ عَمَّنْ سِوَاكَ",
    "lo": {
      "en": "Allahummak-fini bi-halalika 'an haramik, wa aghnini bi-fadlika 'amman siwak",
      "hi": "Allahummak-fini bi-halalika 'an haramik, wa aghnini bi-fadlika 'amman siwak",
      "ur": "Allahummak-fini bi-halalika 'an haramik, wa aghnini bi-fadlika 'amman siwak"
    },
    "me": {
      "en": "O Allah, suffice me with what is lawful against what is unlawful, and enrich me by Your grace so that I have no need of anyone besides You.",
      "hi": "O Allah, suffice me with what is lawful against what is unlawful, and enrich me by Your grace so that I have no need of anyone besides You.",
      "ur": "O Allah, suffice me with what is lawful against what is unlawful, and enrich me by Your grace so that I have no need of anyone besides You."
    },
    "title": {
      "en": "For Debt Relief and Freedom from Loans",
      "hi": "भारी क़र्ज़ से नजात की दुआ (हज़रत अली रज़ि.)",
      "ur": "भारी क़र्ज़ से नजात की दुआ (हज़रत अली रज़ि.)"
    },
    "tm": {
      "en": "After prayers and during times of supplication when burdened by debt.",
      "hi": "After prayers and during times of supplication when burdened by debt.",
      "ur": "After prayers and during times of supplication when burdened by debt."
    },
    "how": {
      "en": "Ali (RA) taught this supplication and said: 'Even if you had a mountain of debt, Allah would settle it for you.' Virtue & Benefit: Guarantees divine sufficiency, halal sustenance, and settling overwhelming debts.",
      "hi": "Ali (RA) taught this supplication and said: 'Even if you had a mountain of debt, Allah would settle it for you.' फ़ज़ीलत: Guarantees divine sufficiency, halal sustenance, and settling overwhelming debts.",
      "ur": "Ali (RA) taught this supplication and said: 'Even if you had a mountain of debt, Allah would settle it for you.' فضیلت: Guarantees divine sufficiency, halal sustenance, and settling overwhelming debts."
    },
    "ref": "Jami' at-Tirmidhi (3563) | Hasan",
    "active": true
  },
  {
    "id": "dua_v_031",
    "cat": "rizq",
    "subcat": "for_protection_from_pover",
    "allCats": [
      "rizq"
    ],
    "ar": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْكُفْرِ وَالْفَقْرِ، وَأَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ، لَا إِلَٰهَ إِلَّا أَنْتَ",
    "lo": {
      "en": "Allahumma inni a'udhu bika minal-kufri wal-faqr, wa a'udhu bika min 'adhabil-qabr, la ilaha illa Ant",
      "hi": "Allahumma inni a'udhu bika minal-kufri wal-faqr, wa a'udhu bika min 'adhabil-qabr, la ilaha illa Ant",
      "ur": "Allahumma inni a'udhu bika minal-kufri wal-faqr, wa a'udhu bika min 'adhabil-qabr, la ilaha illa Ant"
    },
    "me": {
      "en": "O Allah, I seek refuge in You from disbelief and poverty, and I seek refuge in You from the torment of the grave. There is no deity worthy of worship except You.",
      "hi": "O Allah, I seek refuge in You from disbelief and poverty, and I seek refuge in You from the torment of the grave. There is no deity worthy of worship except You.",
      "ur": "O Allah, I seek refuge in You from disbelief and poverty, and I seek refuge in You from the torment of the grave. There is no deity worthy of worship except You."
    },
    "title": {
      "en": "For Protection from Poverty and Need",
      "hi": "ग़रीबी, तंगी व मोहताजी से पनाह की दुआ",
      "ur": "ग़रीबी, तंगी व मोहताजी से पनाह की दुआ"
    },
    "tm": {
      "en": "Three times in the morning and three times in the evening.",
      "hi": "Three times in the morning and three times in the evening.",
      "ur": "Three times in the morning and three times in the evening."
    },
    "how": {
      "en": "Count: 3 times morning, 3 times evening.  Recite three times in the morning and three times in the evening. Virtue & Benefit: Protects against spiritual ruin (Kufr), financial destitution (Faqr), and punishment in the Grave.",
      "hi": "तादाद: 3 times morning, 3 times evening। Recite three times in the morning and three times in the evening. फ़ज़ीलत: Protects against spiritual ruin (Kufr), financial destitution (Faqr), and punishment in the Grave.",
      "ur": "تعداد: 3 times morning, 3 times evening। Recite three times in the morning and three times in the evening. فضیلت: Protects against spiritual ruin (Kufr), financial destitution (Faqr), and punishment in the Grave."
    },
    "ref": "Sunan Abi Dawud & Sunan an-Nasa'i (Abu Dawud 5090 / Nasa'i 5465) | Hasan / Sahih",
    "active": true
  },
