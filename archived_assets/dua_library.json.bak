      "ur": "Bismikallahumma amutu wa ahya"
    },
    "me": {
      "en": "In Your name, O Allah, I die and I live.",
      "hi": "In Your name, O Allah, I die and I live.",
      "ur": "In Your name, O Allah, I die and I live."
    },
    "title": {
      "en": "Before Sleeping",
      "hi": "सोने से पहले की दुआ",
      "ur": "सोने से पहले की दुआ"
    },
    "tm": {
      "en": "When lying down in bed to sleep at night.",
      "hi": "When lying down in bed to sleep at night.",
      "ur": "When lying down in bed to sleep at night."
    },
    "how": {
      "en": "Count: 1 time.  Lie on your right side, place your right hand under your right cheek, and recite. Virtue & Benefit: Entrusts the soul to Allah during sleep (the minor death).",
      "hi": "तादाद: 1 time। Lie on your right side, place your right hand under your right cheek, and recite. फ़ज़ीलत: Entrusts the soul to Allah during sleep (the minor death).",
      "ur": "تعداد: 1 time। Lie on your right side, place your right hand under your right cheek, and recite. فضیلت: Entrusts the soul to Allah during sleep (the minor death)."
    },
