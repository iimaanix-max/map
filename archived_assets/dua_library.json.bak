    },
    "me": {
      "en": "Ask Allah for forgiveness and well-being, for after certainty of faith, no one is given anything better than well-being.",
      "hi": "Ask Allah for forgiveness and well-being, for after certainty of faith, no one is given anything better than well-being.",
      "ur": "Ask Allah for forgiveness and well-being, for after certainty of faith, no one is given anything better than well-being."
