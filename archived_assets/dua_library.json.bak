[
  {
    "id": "dua_v_condolence_001",
    "cat": "grief",
    "subcat": "condolence_bereavement",
    "allCats": [
      "grief",
      "daily",
      "general"
    ],
    "ar": "أَعْظَمَ اللهُ أَجْرَكَ، وَأَحْسَنَ عَزَاءَكَ، وَغَفَرَ لِمَيِّتِكَ",
    "lo": {
      "en": "A'dhamallaahu 'aj'raka, wa 'ahsana 'azaa'aka wa ghafara limayyitika.",
      "hi": "अ'ज़मल्लाहु अज्रका, व अह्सना अज़ा'अका व ग़फ़रा लिमय्यितिका।",
      "ur": "اعظم اللہ اجرک، واحسن عزاءک، وغفر لمیتک"
    },
    "me": {
      "en": "May Allah magnify your reward, and make perfect your bereavement, and forgive your departed.",
      "hi": "अल्लाह आपके सवाब को बढ़ाए, आपके सब्र को बेहतरीन करे और आपके मरहूम की मग़फ़िरत फ़रमाए।",
      "ur": "اللہ آپ کے اجر کو بڑا کرے، آپ کے صبر کو بہترین بنائے اور آپ کے میت کی مغفرت فرمائے۔",
      "ar": "عظّم الله أجرك، وأحسن عزاءك، وغفر لميتك.",
      "bn": "আল্লাহ আপনার প্রতিদান বৃদ্ধি করুন, আপনার শোক শান্ত করুন এবং আপনার মৃতকে ক্ষমা করুন।",
      "tr": "Allah mükâfatını artırsın, taziyeni güzel eylesin ve ölünü bağışlasın.",
      "id": "Semoga Allah melipatgandakan pahalamu, memberikan ketabahan yang baik bagimu, dan mengampuni jenazahmu.",
      "ms": "Semoga Allah melipatgandakan pahalamu, mengelokkan kesabaranmu dan mengampuni si matimu.",
      "fr": "Qu'Allah augmente ta rétribution, rende parfaites tes condoléances et pardonne à ton défunt.",
      "de": "Möge Allah deinen Lohn mehren, deine Trauer vollkommen machen und deinem Verstorbenen vergeben."
    },
    "rf": {
      "en": "1 Al-Bukhari 2/80, Muslim 2/636",
      "hi": "अल-बुख़ारी 2/80, मुस्लिम 2/636",
      "ur": "البخاری 2/80، مسلم 2/636"
    }
  },
  {
    "id": "dua_v_001",
    "cat": "travel",
    "subcat": "when_boarding_a_vehicle_o",
    "allCats": [
      "travel",
      "daily_life"
    ],
    "ar": "سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَٰذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ وَإِنَّا إِلَىٰ رَبِّنَا لَمُنقَلِبُونَ",
    "lo": {
      "en": "Subhana-alladhi sakh-khara lana hadha wa ma kunna lahu muqrinin, wa inna ila Rabbina lamunqalibun",
      "hi": "Subhana-alladhi sakh-khara lana hadha wa ma kunna lahu muqrinin, wa inna ila Rabbina lamunqalibun",
      "ur": "Subhana-alladhi sakh-khara lana hadha wa ma kunna lahu muqrinin, wa inna ila Rabbina lamunqalibun"
    },
    "me": {
      "en": "Glory be to Him who has subjected this to us, for we could never have done so by ourselves. And surely, to our Lord is our return.",
      "hi": "ऐ अल्लाह! मैं तुझसे तेरे फ़ज़्ल का सवाल करता हूँ।",
      "ur": "اے اللہ! میں تجھ سے تیرے فضل کا سوال کرتا ہوں۔"
    },
    "title": {
      "en": "When Boarding a Vehicle or Starting a Journey",
      "hi": "सवारी पर सवार होने / सफ़र शुरू करने की दुआ",
      "ur": "सवारी पर सवार होने / सफ़र शुरू करने की दुआ"
    },
    "tm": {
      "en": "When mounting a riding animal or boarding any vehicle (car, bus, train, aircraft) at the start of a journey.",
      "hi": "When mounting a riding animal or boarding any vehicle (car, bus, train, aircraft) at the start of a journey.",
      "ur": "When mounting a riding animal or boarding any vehicle (car, bus, train, aircraft) at the start of a journey."
    },
    "how": {
      "en": "Count: 1 time.  Say 'Allahu Akbar' three times upon mounting or seating, then recite this supplication. Virtue & Benefit: Acknowledges Allah's supreme blessing, secures divine protection, and affirms the believer's ultimate return to Allah.",
      "hi": "तादाद: 1 time। Say 'Allahu Akbar' three times upon mounting or seating, then recite this supplication. फ़ज़ीलत: Acknowledges Allah's supreme blessing, secures divine protection, and affirms the believer's ultimate return to Allah.",
      "ur": "تعداد: 1 time। Say 'Allahu Akbar' three times upon mounting or seating, then recite this supplication. فضیلت: Acknowledges Allah's supreme blessing, secures divine protection, and affirms the believer's ultimate return to Allah."
    },
    "ref": "Sahih Muslim (1342) | Sahih",
    "active": true
  },
  {
    "id": "dua_v_002",
    "cat": "travel",
    "subcat": "when_returning_from_a_jou",
    "allCats": [
      "travel",
      "daily_life"
    ],
    "ar": "آيِبُونَ تَائِبُونَ عَابِدُونَ لِرَبِّنَا حَامِدُونَ",
    "lo": {
      "en": "Ayibuna, ta'ibuna, 'abiduna, li-Rabbina hamidun",
      "hi": "Ayibuna, ta'ibuna, 'abiduna, li-Rabbina hamidun",
      "ur": "Ayibuna, ta'ibuna, 'abiduna, li-Rabbina hamidun"
    },
    "me": {
      "en": "We return, repent, worship, and praise our Lord.",
      "hi": "We return, repent, worship, and praise our Lord.",
      "ur": "We return, repent, worship, and praise our Lord."
    },
    "title": {
      "en": "When Returning from a Journey",
      "hi": "सफ़र से वापसी की दुआ",
      "ur": "सफ़र से वापसी की दुआ"
    },
    "tm": {
      "en": "When returning from travel, upon sighting one's town or approaching one's home.",
      "hi": "When returning from travel, upon sighting one's town or approaching one's home.",
      "ur": "When returning from travel, upon sighting one's town or approaching one's home."
    },
    "how": {
      "en": "Count: Repeated until arrival.  Repeat these words continuously as you approach your home town. Virtue & Benefit: Affirms continuous repentance, gratitude, and dedication of worship to Allah upon safe return.",
      "hi": "तादाद: Repeated until arrival। Repeat these words continuously as you approach your home town. फ़ज़ीलत: Affirms continuous repentance, gratitude, and dedication of worship to Allah upon safe return.",
      "ur": "تعداد: Repeated until arrival। Repeat these words continuously as you approach your home town. فضیلت: Affirms continuous repentance, gratitude, and dedication of worship to Allah upon safe return."
    },
    "ref": "Sahih al-Bukhari & Sahih Muslim (Bukhari 1797 / Muslim 1342) | Sahih",
    "active": true
  },
  {
    "id": "dua_v_003",
    "cat": "travel",
    "subcat": "when_entering_a_town_or_c",
    "allCats": [
      "travel",
      "daily_life",
      "self_control",
      "temptation",
      "zina"
    ],
    "ar": "اللَّهُمَّ رَبَّ السَّمَاوَاتِ السَّبْعِ وَمَا أَظْلَلْنَ، وَرَبَّ الأَرَضِينَ السَّبْعِ وَمَا أَقْلَلْنَ، أَسْأَلُكَ خَيْرَ هَٰذِهِ الْقَرْيَةِ وَخَيْرَ أَهْلِهَا، وَأَعُوذُ بِكَ مِنْ شَرِّهَا وَشَرِّ أَهْلِهَا",
    "lo": {
      "en": "Allahumma Rabba-samawatis-sab'i wa ma azlalna, wa Rabbal-aradinas-sab'i wa ma aqlalna, as'aluka khayra hadhihil-qaryati wa khayra ahliha, wa a'udhu bika min sharriha wa sharri ahliha",
      "hi": "Allahumma Rabba-samawatis-sab'i wa ma azlalna, wa Rabbal-aradinas-sab'i wa ma aqlalna, as'aluka khayra hadhihil-qaryati wa khayra ahliha, wa a'udhu bika min sharriha wa sharri ahliha",
      "ur": "Allahumma Rabba-samawatis-sab'i wa ma azlalna, wa Rabbal-aradinas-sab'i wa ma aqlalna, as'aluka khayra hadhihil-qaryati wa khayra ahliha, wa a'udhu bika min sharriha wa sharri ahliha"
    },
    "me": {
      "en": "O Allah, Lord of the seven heavens and all they overshadow, Lord of the seven earths and all they carry! I ask You for the goodness of this town and the goodness of its people, and seek refuge in You from its evil and the evil of its people.",
      "hi": "O Allah, Lord of the seven heavens and all they overshadow, Lord of the seven earths and all they carry! I ask You for the goodness of this town and the goodness of its people, and seek refuge in You from its evil and the evil of its people.",
      "ur": "O Allah, Lord of the seven heavens and all they overshadow, Lord of the seven earths and all they carry! I ask You for the goodness of this town and the goodness of its people, and seek refuge in You from its evil and the evil of its people."
    },
    "title": {
      "en": "When Entering a Town or City",
      "hi": "किसी नए शहर या बस्ती में दाख़िल होने की दुआ",
      "ur": "किसी नए शहर या बस्ती में दाख़िल होने की दुआ"
    },
    "tm": {
      "en": "Upon approaching and entering a new town, city, or destination.",
      "hi": "Upon approaching and entering a new town, city, or destination.",
      "ur": "Upon approaching and entering a new town, city, or destination."
    },
    "how": {
      "en": "Count: 1 time.  Recite when viewing the settlement before entering it. Virtue & Benefit: Protects against harm, hardship, and hostility from local elements while seeking all potential good.",
      "hi": "तादाद: 1 time। Recite when viewing the settlement before entering it. फ़ज़ीलत: Protects against harm, hardship, and hostility from local elements while seeking all potential good.",
      "ur": "تعداد: 1 time। Recite when viewing the settlement before entering it. فضیلت: Protects against harm, hardship, and hostility from local elements while seeking all potential good."
    },
    "ref": "Al-Mustadrak 'ala al-Sahihayn (Al-Hakim) (2/100) | Sahih (confirmed by Adh-Dhahabi and Al-Albani)",
    "active": true
  },
  {
    "id": "dua_v_004",
    "cat": "travel",
    "subcat": "when_halting_or_lodging_a",
    "allCats": [
      "travel",
      "daily_life",
      "self_control",
      "temptation",
      "zina"
    ],
    "ar": "أَعُوذُ بِكَلِمَاتِ اللَّهِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ",
    "lo": {
      "en": "A'udhu bi-kalimatil-lahit-tammati min sharri ma khalaq",
      "hi": "अऊज़ु बि-कलिमातिल्लाहित-ताम्माति मिन् शर्री मा ख़लक़",
      "ur": "اعوذ بکلمات اللہ التامات من شر ما خلق"
    },
    "me": {
      "en": "I seek refuge in the perfect words of Allah from the evil of whatever He has created.",
      "hi": "मैं अल्लाह के मुकम्मल कलिमात की पनाह मांगता हूँ हर उस चीज़ के शर्र से जो उसने पैदा की है।",
      "ur": "میں اللہ کے کامل کلمات کی پناہ مانگتا ہوں ہر اس چیز کے شر سے جو اس نے پیدا کی۔"
    },
    "title": {
      "en": "When Halting or Lodging at a Place During Travel",
      "hi": "सफ़र में किसी जगह पड़ाव / होटल में रुकने की दुआ",
      "ur": "سفر میں کسی جگہ قیام یا پڑاؤ ڈالتے وقت کی دعا"
    },
    "tm": {
      "en": "Upon stopping, lodging, or resting at any place during travel or daily movement.",
      "hi": "सफ़र के दौरान या किसी नई जगह पर ठहरने, रुकने या होटल में पड़ाव डालते वक्त।",
      "ur": "سفر کے دوران یا کسی نئی جگہ قیام، پڑاؤ یا ہوٹل وغیرہ میں ٹھہرتے وقت۔"
    },
    "how": {
      "en": "Count: 1 time.  Recite immediately upon settling in the new location. Virtue & Benefit: The Prophet ﷺ stated: 'Nothing shall harm him until he departs from that place.'",
      "hi": "तादाद: 1 बार। नई जगह पर पहुँचते ही पढ़ें। फ़ज़ीलत: हुज़ूर ﷺ ने फ़रमाया: 'जब तक वह उस जगह से रवाना न हो जाए, कोई चीज़ उसे नुकसान नहीं पहुँचाएगी।'",
      "ur": "تعداد: 1 بار۔ نئی جگہ پہنچتے ہی پڑھیں۔ فضیلت: نبی کریم ﷺ نے فرمایا: 'جب تک وہ اس جگہ سے روانہ نہ ہو جائے، کوئی چیز اسے نقصان نہیں پہنچائے گی۔'"
    },
    "ref": "Sahih Muslim (2708) | Sahih",
    "active": true
  },
  {
    "id": "dua_v_005",
    "cat": "travel",
    "subcat": "when_bidding_farewell_to_",
    "allCats": [
      "travel",
      "daily_life"
    ],
    "ar": "أَسْتَوْدِعُ اللَّهَ دِينَكَ، وَأَمَانَتَكَ، وَخَوَاتِيمَ عَمَلِكَ",
    "lo": {
      "en": "Astawdi'ullaha dinaka, wa amanataka, wa khawatima 'amalik",
      "hi": "Astawdi'ullaha dinaka, wa amanataka, wa khawatima 'amalik",
      "ur": "Astawdi'ullaha dinaka, wa amanataka, wa khawatima 'amalik"
    },
    "me": {
      "en": "I entrust to Allah your religion, your trust, and the outcomes of your deeds.",
      "hi": "I entrust to Allah your religion, your trust, and the outcomes of your deeds.",
      "ur": "I entrust to Allah your religion, your trust, and the outcomes of your deeds."
    },
    "title": {
      "en": "When Bidding Farewell to a Traveler",
      "hi": "मुसाफ़िर को अलविदा कहने व हिफ़ाज़त की दुआ",
      "ur": "मुसाफ़िर को अलविदा कहने व हिफ़ाज़त की दुआ"
    },
    "tm": {
      "en": "When seeing off or saying goodbye to someone departing on a journey.",
      "hi": "When seeing off or saying goodbye to someone departing on a journey.",
      "ur": "When seeing off or saying goodbye to someone departing on a journey."
    },
    "how": {
      "en": "Count: 1 time.  Say while taking the hand of the traveler to bid farewell. Virtue & Benefit: Places the traveler's faith, honesty, and final deeds under divine preservation during their absence.",
      "hi": "तादाद: 1 time। Say while taking the hand of the traveler to bid farewell. फ़ज़ीलत: Places the traveler's faith, honesty, and final deeds under divine preservation during their absence.",
      "ur": "تعداد: 1 time। Say while taking the hand of the traveler to bid farewell. فضیلت: Places the traveler's faith, honesty, and final deeds under divine preservation during their absence."
    },
    "ref": "Jami' at-Tirmidhi & Sunan Abi Dawud (Tirmidhi 3443 / Abu Dawud 2600) | Sahih",
    "active": true
  },
  {
    "id": "dua_v_006",
    "cat": "food",
    "subcat": "before_meal",
    "allCats": [
      "food",
      "daily_life"
    ],
    "ar": "بِسْمِ اللَّهِ",
    "lo": {
      "en": "Bismillah",
      "hi": "Bismillah",
      "ur": "Bismillah"
    },
    "me": {
      "en": "In the name of Allah.",
      "hi": "In the name of Allah.",
      "ur": "In the name of Allah."
    },
    "title": {
      "en": "Before Eating",
      "hi": "खाना शुरू करने से पहले की दुआ",
      "ur": "खाना शुरू करने से पहले की दुआ"
    },
    "tm": {
      "en": "Immediately before taking the first bite or drink of a meal.",
      "hi": "Immediately before taking the first bite or drink of a meal.",
      "ur": "Immediately before taking the first bite or drink of a meal."
    },
    "how": {
      "en": "Count: 1 time.  Eat with the right hand and say Bismillah. Virtue & Benefit: Blesses the meal and prevents Shaytan from sharing in the food.",
      "hi": "तादाद: 1 time। Eat with the right hand and say Bismillah. फ़ज़ीलत: Blesses the meal and prevents Shaytan from sharing in the food.",
      "ur": "تعداد: 1 time। Eat with the right hand and say Bismillah. فضیلت: Blesses the meal and prevents Shaytan from sharing in the food."
    },
    "ref": "Sahih al-Bukhari & Sahih Muslim (Bukhari 5376 / Muslim 2022) | Sahih",
    "active": true
  },
  {
    "id": "dua_v_007",
    "cat": "food",
    "subcat": "before_meal",
    "allCats": [
      "food",
      "daily_life"
    ],
    "ar": "بِسْمِ اللَّهِ أَوَّلَهُ وَآخِرَهُ",
    "lo": {
      "en": "Bismillahi awwalahu wa akhirahu",
      "hi": "Bismillahi awwalahu wa akhirahu",
      "ur": "Bismillahi awwalahu wa akhirahu"
    },
    "me": {
      "en": "In the name of Allah, at its beginning and at its end.",
      "hi": "In the name of Allah, at its beginning and at its end.",
      "ur": "In the name of Allah, at its beginning and at its end."
    },
    "title": {
      "en": "If Bismillah Was Forgotten at the Start",
      "hi": "शुरू में बिस्मिल्लाह भूल जाने पर की दुआ",
      "ur": "शुरू में बिस्मिल्लाह भूल जाने पर की दुआ"
    },
    "tm": {
      "en": "If one forgot to say Bismillah at the beginning and remembered during the meal.",
      "hi": "If one forgot to say Bismillah at the beginning and remembered during the meal.",
      "ur": "If one forgot to say Bismillah at the beginning and remembered during the meal."
    },
    "how": {
      "en": "Count: 1 time.  Recite immediately as soon as one remembers while eating. Virtue & Benefit: The Prophet ﷺ mentioned that Shaytan vomits what he ate from the food once this is recited.",
      "hi": "तादाद: 1 time। Recite immediately as soon as one remembers while eating. फ़ज़ीलत: The Prophet ﷺ mentioned that Shaytan vomits what he ate from the food once this is recited.",
      "ur": "تعداد: 1 time। Recite immediately as soon as one remembers while eating. فضیلت: The Prophet ﷺ mentioned that Shaytan vomits what he ate from the food once this is recited."
    },
    "ref": "Sunan Abi Dawud & Jami' at-Tirmidhi (Abu Dawud 3767 / Tirmidhi 1858) | Sahih",
    "active": true
  },
  {
    "id": "dua_v_008",
    "cat": "food",
    "subcat": "after_meal",
    "allCats": [
      "food",
      "daily_life"
    ],
    "ar": "الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنِي هَٰذَا وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلَا قُوَّةٍ",
    "lo": {
      "en": "Alhamdu lillahil-ladhi at'amani hadha wa razaqanihi min ghayri hawlin minni wa la quwwah",
      "hi": "Alhamdu lillahil-ladhi at'amani hadha wa razaqanihi min ghayri hawlin minni wa la quwwah",
      "ur": "Alhamdu lillahil-ladhi at'amani hadha wa razaqanihi min ghayri hawlin minni wa la quwwah"
    },
    "me": {
      "en": "All praise is due to Allah who fed me this and provided it for me without any power or might from myself.",
      "hi": "All praise is due to Allah who fed me this and provided it for me without any power or might from myself.",
      "ur": "All praise is due to Allah who fed me this and provided it for me without any power or might from myself."
    },
    "title": {
      "en": "After Eating",
      "hi": "खाना खाने के बाद की दुआ",
      "ur": "खाना खाने के बाद की दुआ"
    },
    "tm": {
      "en": "Upon concluding a meal.",
      "hi": "Upon concluding a meal.",
      "ur": "Upon concluding a meal."
    },
    "how": {
      "en": "Count: 1 time.  Recite with gratitude after concluding the meal. Virtue & Benefit: The Prophet ﷺ said: 'Whoever says this after eating, his past sins will be forgiven.'",
      "hi": "तादाद: 1 time। Recite with gratitude after concluding the meal. फ़ज़ीलत: The Prophet ﷺ said: 'Whoever says this after eating, his past sins will be forgiven.'",
      "ur": "تعداد: 1 time। Recite with gratitude after concluding the meal. فضیلت: The Prophet ﷺ said: 'Whoever says this after eating, his past sins will be forgiven.'"
    },
    "ref": "Jami' at-Tirmidhi & Sunan Abi Dawud (Tirmidhi 3458 / Abu Dawud 4023) | Hasan / Sahih",
    "active": true
  },
  {
    "id": "dua_v_009",
    "cat": "food",
    "subcat": "after_meal",
    "allCats": [
      "food",
      "daily_life"
    ],
    "ar": "اللَّهُمَّ بَارِكْ لَنَا فِيهِ وَزِدْنَا مِنْهُ",
    "lo": {
      "en": "Allahumma barik lana fihi wa zidna minh",
