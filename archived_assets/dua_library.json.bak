      "heart"
    ],
    "ar": "اللَّهُمَّ طَهِّرْ قَلْبِي مِنَ النِّفَاقِ، وَعَمَلِي مِنَ الرِّيَاءِ، وَلِسَانِي مِنَ الْكَذِبِ، وَعَيْنِي مِنَ الْخِيَانَةِ، فَإِنَّكَ تَعْلَمُ خَائِنَةَ الْأَعْيُنِ وَمَا تُخْفِي الصُّدُورُ",
    "lo": {
      "en": "Allahumma tahhir qalbi minan-nifaq, wa 'amali minar-riya', wa lisani minal-kadhib, wa 'ayni minal-khiyanah, fa innaka ta'lamu kha'inatal-a'yuni wa ma tukhfis-sudur.",
      "hi": "Allahumma tahhir qalbi minan-nifaq, wa 'amali minar-riya', wa lisani minal-kadhib, wa 'ayni minal-khiyanah, fa innaka ta'lamu kha'inatal-a'yuni wa ma tukhfis-sudur.",
      "ur": "Allahumma tahhir qalbi minan-nifaq, wa 'amali minar-riya', wa lisani minal-kadhib, wa 'ayni minal-khiyanah, fa innaka ta'lamu kha'inatal-a'yuni wa ma tukhfis-sudur."
    },
    "me": {
      "en": "O Allah, purify my heart from hypocrisy, my deeds from showing off, my tongue from lying, and my eyes from betrayal. Indeed, You know the stealth of the eyes and what the hearts conceal.",
      "hi": "O Allah, purify my heart from hypocrisy, my deeds from showing off, my tongue from lying, and my eyes from betrayal. Indeed, You know the stealth of the eyes and what the hearts conceal.",
      "ur": "O Allah, purify my heart from hypocrisy, my deeds from showing off, my tongue from lying, and my eyes from betrayal. Indeed, You know the stealth of the eyes and what the hearts conceal."
    },
