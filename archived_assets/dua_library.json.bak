      "heart"
    ],
    "ar": "ضَعْ يَدَكَ عَلَى الَّذِي تَأَلَّمَ مِنْ جَسَدِكَ، وَقُلْ: بِسْمِ اللَّهِ، ثَلَاثًا، وَقُلْ سَبْعَ مَرَّاتٍ: أَعُوذُ بِاللَّهِ وَقُدْرَتِهِ، مِنْ شَرِّ مَا أَجِدُ وَأُحَاذِرُ",
    "lo": {
      "en": "Place your hand on the area of pain and say 'Bismillah' three times, then seven times: A'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir.",
      "hi": "Place your hand on the area of pain and say 'Bismillah' three times, then seven times: A'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir.",
      "ur": "Place your hand on the area of pain and say 'Bismillah' three times, then seven times: A'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir."
    },
    "me": {
      "en": "Place your hand on the part of your body that hurts, say 'Bismillah' three times, then seven times: I seek refuge in Allah and His Power from the evil of what I feel and fear.",
      "hi": "Place your hand on the part of your body that hurts, say 'Bismillah' three times, then seven times: I seek refuge in Allah and His Power from the evil of what I feel and fear.",
      "ur": "Place your hand on the part of your body that hurts, say 'Bismillah' three times, then seven times: I seek refuge in Allah and His Power from the evil of what I feel and fear."
