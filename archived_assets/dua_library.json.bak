    },
    "title": {
      "en": "When In Severe Distress (Dua al-Karb)",
      "hi": "बड़ी मुसीबत व परेशानी के वक़्त की दुआ (दुआ अल-कर्ब)",
      "ur": "बड़ी मुसीबत व परेशानी के वक़्त की दुआ (दुआ अल-कर्ब)"
    },
    "tm": {
