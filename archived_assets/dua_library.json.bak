  {
    "id": "dua_v_072",
    "cat": "akhirah",
    "subcat": "for_the_deceased_and_salv",
    "allCats": [
      "death_janazah",
      "akhirah"
    ],
    "ar": "اللَّهُمَّ اغْفِرْ لَهُ وَارْحَمْهُ، وَعَافِهِ وَاعْفُ عَنْهُ، وَأَكْرِمْ نُزُلَهُ، وَوَسِّعْ مُدْخَلَهُ، وَاغْسِلْهُ بِالْمَاءِ وَالثَّلْجِ وَالْبَرَدِ، وَنَقِّهِ مِنَ الْخَطَايَا كَمَا نَقَّيْتَ الثَّوْبَ الْأَبْيَضَ مِنَ الدَّنَسِ، وَأَبْدِلْهُ دَارًا خَيْرًا مِنْ دَارِهِ، وَأَهْلًا خَيْرًا مِنْ أَهْلِهِ، وَزَوْجًا خَيْرًا مِنْ زَوْجِهِ، وَأَدْخِلْهُ الْجَنَّةَ، وَأَعِذْهُ مِنْ عَذَابِ الْقَبْرِ وَمِنْ عَذَابِ النَّارِ",
    "lo": {
      "en": "Allahummaghfir lahu warhamhu, wa 'afihi wa'fu 'anhu, wa akrim nuzulahu, wa wassi' mudkhalahu, waghsilhu bil-ma'i wath-thalji wal-barad... wa adkhilhul-jannah, wa a'idhhu min 'adhabil-qabri wa min 'adhabin-nar.",
      "hi": "Allahummaghfir lahu warhamhu, wa 'afihi wa'fu 'anhu, wa akrim nuzulahu, wa wassi' mudkhalahu, waghsilhu bil-ma'i wath-thalji wal-barad... wa adkhilhul-jannah, wa a'idhhu min 'adhabil-qabri wa min 'adhabin-nar.",
      "ur": "Allahummaghfir lahu warhamhu, wa 'afihi wa'fu 'anhu, wa akrim nuzulahu, wa wassi' mudkhalahu, waghsilhu bil-ma'i wath-thalji wal-barad... wa adkhilhul-jannah, wa a'idhhu min 'adhabil-qabri wa min 'adhabin-nar."
    },
    "me": {
      "en": "O Allah, forgive him, have mercy on him, grant him well-being, pardon him, honor his abode, expand his grave, cleanse him of sins as a white garment is cleansed of dirt, grant him a better home, family and spouse, admit him into Paradise, and protect him from the punishment of the grave and the Fire.",
      "hi": "O Allah, forgive him, have mercy on him, grant him well-being, pardon him, honor his abode, expand his grave, cleanse him of sins as a white garment is cleansed of dirt, grant him a better home, family and spouse, admit him into Paradise, and protect him from the punishment of the grave and the Fire.",
      "ur": "O Allah, forgive him, have mercy on him, grant him well-being, pardon him, honor his abode, expand his grave, cleanse him of sins as a white garment is cleansed of dirt, grant him a better home, family and spouse, admit him into Paradise, and protect him from the punishment of the grave and the Fire."
    },
    "title": {
      "en": "For the Deceased and Salvation in the Hereafter",
