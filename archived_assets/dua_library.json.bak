    "ar": "بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ",
    "lo": {
      "en": "Bismillahi-lladhi la yadurru ma'as-mihi shay'un fil-ardi wa la fis-sama'i wa Huwas-Sami'ul-'Alim",
      "hi": "बिस्मिल्लाहिल्लज़ी ला यदुर्रु म'अस्मिही शैउन फ़िल-अर्दि वला फ़िस-समाइ व हुवस-समी'उल-'अलीम।",
      "ur": "بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ"
    },
    "me": {
      "en": "In the name of Allah, with whose name nothing can cause harm in the earth or in the heaven, and He is the All-Hearing, the All-Knowing.",
      "hi": "अल्लाह के नाम के साथ, जिसके नाम की बरकत से ज़मीन और आसमान की कोई चीज़ नुक़सान नहीं पहुँचा सकती, और वही सब कुछ सुनने वाला, सब कुछ जानने वाला है।",
      "ur": "اللہ کے نام کے ساتھ، جس کے نام کی برکت سے زمین اور آسمان کی کوئی چیز نقصان نہیں پہنچا سکتی، اور وہی خوب سننے والا، سب کچھ جاننے والا ہے۔"
    },
    "title": {
      "en": "For Protection in the Morning and Evening",
      "hi": "सुबह और शाम हिफ़ाज़त की दुआ",
      "ur": "सुबह और शाम हिफ़ाज़त की दुआ"
    },
    "tm": {
      "en": "Morning (after Fajr) and evening (after Asr/Maghrib).",
      "hi": "Morning (after Fajr) and evening (after Asr/Maghrib).",
      "ur": "Morning (after Fajr) and evening (after Asr/Maghrib)."
    },
    "how": {
      "en": "Count: 3 times morning, 3 times evening.  Recite three times in the morning and three times in the evening. Virtue & Benefit: The Prophet ﷺ said: 'Whoever recites it three times in the morning and three times in the evening, nothing will harm him.'",
      "hi": "तादाद: 3 times morning, 3 times evening। Recite three times in the morning and three times in the evening. फ़ज़ीलत: The Prophet ﷺ said: 'Whoever recites it three times in the morning and three times in the evening, nothing will harm him.'",
      "ur": "تعداد: 3 times morning, 3 times evening। Recite three times in the morning and three times in the evening. فضیلت: The Prophet ﷺ said: 'Whoever recites it three times in the morning and three times in the evening, nothing will harm him.'"
    },
    "ref": "Jami' at-Tirmidhi & Sunan Abi Dawud (Tirmidhi 3388 / Abu Dawud 5088) | Sahih",
