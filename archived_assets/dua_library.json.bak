    "ar": "أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ، لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ",
    "lo": {
      "en": "Asbahna wa asbahal-mulku lillah, wal-hamdu lillah, la ilaha illallahu wahdahu la sharika lah, lahul-mulku wa lahul-hamdu wa Huwa 'ala kulli shay'in Qadir",
      "hi": "Asbahna wa asbahal-mulku lillah, wal-hamdu lillah, la ilaha illallahu wahdahu la sharika lah, lahul-mulku wa lahul-hamdu wa Huwa 'ala kulli shay'in Qadir",
      "ur": "Asbahna wa asbahal-mulku lillah, wal-hamdu lillah, la ilaha illallahu wahdahu la sharika lah, lahul-mulku wa lahul-hamdu wa Huwa 'ala kulli shay'in Qadir"
    },
    "me": {
      "en": "We have reached the morning and the kingdom belongs to Allah, and all praise is for Allah. There is no true deity except Allah alone, without partner. His is the sovereignty and His is the praise, and He has power over all things.",
      "hi": "We have reached the morning and the kingdom belongs to Allah, and all praise is for Allah. There is no true deity except Allah alone, without partner. His is the sovereignty and His is the praise, and He has power over all things.",
      "ur": "We have reached the morning and the kingdom belongs to Allah, and all praise is for Allah. There is no true deity except Allah alone, without partner. His is the sovereignty and His is the praise, and He has power over all things."
    },
    "title": {
      "en": "Morning Supplication of Praise and Sovereignty",
      "hi": "सुबह अल्लाह की बादशाही व बड़ाई का इक़रार",
      "ur": "सुबह अल्लाह की बादशाही व बड़ाई का इक़रार"
    },
    "tm": {
