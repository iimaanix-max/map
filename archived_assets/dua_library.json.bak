      "akhirah"
    ],
    "ar": "اللَّهُمَّ اجْعَلْهُ لَنَا فَرَطًا، وَذُخْرًا، وَأَجْرًا، اللَّهُمَّ ثَقِّلْ بِهِ مَوَازِينَنَا، وَأَعْظِمْ بِهِ أُجُورَنَا، وَأَلْحِقْهُ بِصَالِحِ سَلَفِ الْمُؤْمِنِينَ، وَاجْعَلْهُ فِي كَفَالَةِ إِبْرَاهِيمَ، وَقِهِ بِرَحْمَتِكَ عَذَابَ الْجَحِيمِ",
    "lo": {
      "en": "Allahummaj'alhu lana faratan, wa dhukhran, wa ajran. Allahumma thaqqil bihi mawazinana, wa a'zim bihi ujurana, wa alhiqhu bisalihi salafil-mu'minin, waj'alhu fi kafalati Ibrahim, wa qihi birahmatika 'adhabal-jahim.",
      "hi": "Allahummaj'alhu lana faratan, wa dhukhran, wa ajran. Allahumma thaqqil bihi mawazinana, wa a'zim bihi ujurana, wa alhiqhu bisalihi salafil-mu'minin, waj'alhu fi kafalati Ibrahim, wa qihi birahmatika 'adhabal-jahim.",
      "ur": "Allahummaj'alhu lana faratan, wa dhukhran, wa ajran. Allahumma thaqqil bihi mawazinana, wa a'zim bihi ujurana, wa alhiqhu bisalihi salafil-mu'minin, waj'alhu fi kafalati Ibrahim, wa qihi birahmatika 'adhabal-jahim."
    },
    "me": {
      "en": "O Allah, make this child a forerunner, a treasure, and a reward for us. Make our scales heavy through him, increase our reward because of him, join him with the righteous believers, place him under the care of Ibrahim (AS), and protect him from the punishment of Hell by Your mercy.",
      "hi": "O Allah, make this child a forerunner, a treasure, and a reward for us. Make our scales heavy through him, increase our reward because of him, join him with the righteous believers, place him under the care of Ibrahim (AS), and protect him from the punishment of Hell by Your mercy.",
      "ur": "O Allah, make this child a forerunner, a treasure, and a reward for us. Make our scales heavy through him, increase our reward because of him, join him with the righteous believers, place him under the care of Ibrahim (AS), and protect him from the punishment of Hell by Your mercy."
    },
