    "allCats": [
      "fear",
      "protection",
      "daily_life"
    ],
    "ar": "بِسْمِ اللَّهِ أَرْقِيكَ، مِنْ كُلِّ شَيْءٍ يُؤْذِيكَ، مِنْ شَرِّ كُلِّ نَفْسٍ أَوْ عَيْنِ حَاسِدٍ، اللَّهُ يَشْفِيكَ، بِسْمِ اللَّهِ أَرْقِيكَ",
    "lo": {
      "en": "Bismillahi arqik, min kulli shay'in yu'dhik, min sharri kulli nafsin aw 'aynin hasid, Allahu yashfik, bismillahi arqik.",
      "hi": "Bismillahi arqik, min kulli shay'in yu'dhik, min sharri kulli nafsin aw 'aynin hasid, Allahu yashfik, bismillahi arqik.",
      "ur": "Bismillahi arqik, min kulli shay'in yu'dhik, min sharri kulli nafsin aw 'aynin hasid, Allahu yashfik, bismillahi arqik."
    },
    "me": {
      "en": "In the Name of Allah, I perform Ruqyah for you from everything harming you, from every soul and every envious eye. May Allah cure you. In the Name of Allah, I perform Ruqyah for you.",
      "hi": "In the Name of Allah, I perform Ruqyah for you from everything harming you, from every soul and every envious eye. May Allah cure you. In the Name of Allah, I perform Ruqyah for you.",
      "ur": "In the Name of Allah, I perform Ruqyah for you from everything harming you, from every soul and every envious eye. May Allah cure you. In the Name of Allah, I perform Ruqyah for you."
    },
