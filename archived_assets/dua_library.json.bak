  {
    "id": "dua_v_089",
    "cat": "faith_worship",
    "subcat": "steadfastness_on_the_reli",
    "allCats": [
      "faith_worship",
      "heart"
    ],
    "ar": "اللَّهُمَّ رَبَّ جِبْرَائِيلَ وَمِيكَائِيلَ وَإِسْرَافِيلَ، فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ، عَالِمَ الْغَيْبِ وَالشَّهَادَةِ، أَنْتَ تَحْكُمُ بَيْنَ عِبَادِكَ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ، اهْدِنِي لِمَا اخْتُلِفَ فِيهِ مِنَ الْحَقِّ بِإِذْنِكَ، إِنَّكَ تَهْدِي مَنْ تَشَاءُ إِلَىٰ صِرَاطٍ مُسْتَقِيمٍ",
    "lo": {
      "en": "Allahumma Rabba Jibril wa Mika'il wa Israfil, Fatiras-samawati wal-ard, 'Alimal-ghaybi wash-shahadah, Anta tahkumu bayna 'ibadika fima kanu fihi yakhtalifun. Ihdini lima-khtulifa fihi minal-haqqi bi-idhnik. Innaka tahdi man tasha'u ila siratin mustaqim.",
      "hi": "Allahumma Rabba Jibril wa Mika'il wa Israfil, Fatiras-samawati wal-ard, 'Alimal-ghaybi wash-shahadah, Anta tahkumu bayna 'ibadika fima kanu fihi yakhtalifun. Ihdini lima-khtulifa fihi minal-haqqi bi-idhnik. Innaka tahdi man tasha'u ila siratin mustaqim.",
      "ur": "Allahumma Rabba Jibril wa Mika'il wa Israfil, Fatiras-samawati wal-ard, 'Alimal-ghaybi wash-shahadah, Anta tahkumu bayna 'ibadika fima kanu fihi yakhtalifun. Ihdini lima-khtulifa fihi minal-haqqi bi-idhnik. Innaka tahdi man tasha'u ila siratin mustaqim."
    },
    "me": {
      "en": "O Allah, Lord of Jibril, Mika'il and Israfil, Creator of the heavens and the earth, Knower of the unseen and the seen. You judge between Your servants concerning that over which they differ. Guide me, by Your permission, to the truth regarding that in which people differ. Indeed, You guide whom You will to a Straight Path.",
      "hi": "O Allah, Lord of Jibril, Mika'il and Israfil, Creator of the heavens and the earth, Knower of the unseen and the seen. You judge between Your servants concerning that over which they differ. Guide me, by Your permission, to the truth regarding that in which people differ. Indeed, You guide whom You will to a Straight Path.",
      "ur": "O Allah, Lord of Jibril, Mika'il and Israfil, Creator of the heavens and the earth, Knower of the unseen and the seen. You judge between Your servants concerning that over which they differ. Guide me, by Your permission, to the truth regarding that in which people differ. Indeed, You guide whom You will to a Straight Path."
    },
    "title": {
      "en": "Steadfastness on the Religion",
      "hi": "दीन पर साबितक़दमी की दुआ",
      "ur": "दीन पर साबितक़दमी की दुआ"
    },
