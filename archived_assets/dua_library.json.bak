  {
    "id": "dua_v_021",
    "cat": "shifa",
    "subcat": "for_body_pain_(hand_on_pa",
    "allCats": [
      "self_control",
      "shifa",
      "health_shifa",
      "daily_life",
      "temptation",
      "zina"
    ],
    "ar": "بِسْمِ اللَّهِ (٣ مرات)\nأَعُوذُ بِاللَّهِ وَقُدْرَتِهِ مِنْ شَرِّ مَا أَجِدُ وَأُحَاذِرُ (٧ مرات)",
    "lo": {
      "en": "Bismillah (3 times)\nA'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir (7 times)",
      "hi": "Bismillah (3 times)\nA'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir (7 times)",
      "ur": "Bismillah (3 times)\nA'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir (7 times)"
    },
    "me": {
      "en": "In the name of Allah (3 times). I seek refuge in Allah and His power from the evil of what I feel and what I fear (7 times).",
      "hi": "In the name of Allah (3 times). I seek refuge in Allah and His power from the evil of what I feel and what I fear (7 times).",
      "ur": "In the name of Allah (3 times). I seek refuge in Allah and His power from the evil of what I feel and what I fear (7 times)."
    },
    "title": {
      "en": "For Body Pain (Hand on Painful Area)",
      "hi": "शरीर में दर्द की जगह हाथ रखकर पढ़ने की दुआ",
      "ur": "शरीर में दर्द की जगह हाथ रखकर पढ़ने की दुआ"
    },
    "tm": {
      "en": "Whenever feeling pain, ache, or injury anywhere in the body.",
      "hi": "Whenever feeling pain, ache, or injury anywhere in the body.",
      "ur": "Whenever feeling pain, ache, or injury anywhere in the body."
    },
    "how": {
      "en": "Count: Say Bismillah 3 times, then supplication 7 times.  Place your right hand on the area of your body where you feel pain, say 'Bismillah' three times, and then recite 'A'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir' seven times. Virtue & Benefit: Uthman ibn Abi al-As reported that after doing this, Allah completely cured his severe pain.",
      "hi": "तादाद: Say Bismillah 3 times, then supplication 7 times। Place your right hand on the area of your body where you feel pain, say 'Bismillah' three times, and then recite 'A'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir' seven times. फ़ज़ीलत: Uthman ibn Abi al-As reported that after doing this, Allah completely cured his severe pain.",
      "ur": "تعداد: Say Bismillah 3 times, then supplication 7 times। Place your right hand on the area of your body where you feel pain, say 'Bismillah' three times, and then recite 'A'udhu billahi wa qudratihi min sharri ma ajidu wa uhadhir' seven times. فضیلت: Uthman ibn Abi al-As reported that after doing this, Allah completely cured his severe pain."
    },
    "ref": "Sahih Muslim (2202) | Sahih",
    "active": true
  },
  {
