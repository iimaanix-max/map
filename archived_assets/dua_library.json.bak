    "ar": "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ وَمِنْ شَرِّ هَٰذِهِ الرُّؤْيَا",
    "lo": {
      "en": "A'udhu billahi minash-shaytanir-rajimi wa min sharri hadhihir-ru'ya",
      "hi": "A'udhu billahi minash-shaytanir-rajimi wa min sharri hadhihir-ru'ya",
      "ur": "A'udhu billahi minash-shaytanir-rajimi wa min sharri hadhihir-ru'ya"
    },
    "me": {
      "en": "I seek refuge in Allah from the accursed Shaytan and from the evil of this dream.",
      "hi": "I seek refuge in Allah from the accursed Shaytan and from the evil of this dream.",
      "ur": "I seek refuge in Allah from the accursed Shaytan and from the evil of this dream."
    },
    "title": {
      "en": "When Experiencing a Bad Dream or Nightmare",
      "hi": "बुरे ख़्वाब या डर से नींद खुलने पर दुआ",
      "ur": "बुरे ख़्वाब या डर से नींद खुलने पर दुआ"
    },
    "tm": {
      "en": "When waking up frightened from a bad dream or nightmare.",
      "hi": "When waking up frightened from a bad dream or nightmare.",
      "ur": "When waking up frightened from a bad dream or nightmare."
    },
    "how": {
      "en": "Count: 3 times.  Spit (dry spit) to the left three times, seek refuge in Allah from Shaytan and the dream three times, turn over onto the other side, and do not tell anyone about the dream. Virtue & Benefit: The Prophet ﷺ guaranteed: 'It will never harm you.'",
      "hi": "तादाद: 3 times। Spit (dry spit) to the left three times, seek refuge in Allah from Shaytan and the dream three times, turn over onto the other side, and do not tell anyone about the dream. फ़ज़ीलत: The Prophet ﷺ guaranteed: 'It will never harm you.'",
      "ur": "تعداد: 3 times। Spit (dry spit) to the left three times, seek refuge in Allah from Shaytan and the dream three times, turn over onto the other side, and do not tell anyone about the dream. فضیلت: The Prophet ﷺ guaranteed: 'It will never harm you.'"
    },
    "ref": "Sahih Muslim & Sahih al-Bukhari (Muslim 2261 / Bukhari 6986) | Sahih",
    "active": true
  },
  {
    "id": "dua_v_016",
    "cat": "forgiveness",
    "subcat": "istighfar",
    "allCats": [
      "forgiveness",
      "special_dua",
      "morning",
      "evening",
      "jumma_dua",
      "daily_life",
      "self_control"
    ],
    "ar": "اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَٰهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَىٰ عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ لَكَ بِذَنْبِي فَاغْفِرْ لِي فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ",
    "lo": {
      "en": "Allahumma Anta Rabbi la ilaha illa Anta, khalaqtani wa ana 'abduka, wa ana 'ala 'ahdika wa wa'dika mastata'tu, a'udhu bika min sharri ma sana'tu, abu'u laka bini'matika 'alayya, wa abu'u laka bidhanbi faghfir li fa'innahu la yaghfirudh-dhunuba illa Anta",
      "hi": "Allahumma Anta Rabbi la ilaha illa Anta, khalaqtani wa ana 'abduka, wa ana 'ala 'ahdika wa wa'dika mastata'tu, a'udhu bika min sharri ma sana'tu, abu'u laka bini'matika 'alayya, wa abu'u laka bidhanbi faghfir li fa'innahu la yaghfirudh-dhunuba illa Anta",
      "ur": "Allahumma Anta Rabbi la ilaha illa Anta, khalaqtani wa ana 'abduka, wa ana 'ala 'ahdika wa wa'dika mastata'tu, a'udhu bika min sharri ma sana'tu, abu'u laka bini'matika 'alayya, wa abu'u laka bidhanbi faghfir li fa'innahu la yaghfirudh-dhunuba illa Anta"
    },
    "me": {
      "en": "O Allah, You are my Lord; there is no deity worthy of worship except You. You created me and I am Your servant, and I abide by Your covenant and promise as best I can. I seek refuge in You from the evil of what I have done. I acknowledge Your favors upon me and I confess my sins to You, so forgive me, for none can forgive sins except You.",
      "hi": "O Allah, You are my Lord; there is no deity worthy of worship except You. You created me and I am Your servant, and I abide by Your covenant and promise as best I can. I seek refuge in You from the evil of what I have done. I acknowledge Your favors upon me and I confess my sins to You, so forgive me, for none can forgive sins except You.",
      "ur": "O Allah, You are my Lord; there is no deity worthy of worship except You. You created me and I am Your servant, and I abide by Your covenant and promise as best I can. I seek refuge in You from the evil of what I have done. I acknowledge Your favors upon me and I confess my sins to You, so forgive me, for none can forgive sins except You."
    },
    "title": {
      "en": "Master Supplication for Forgiveness (Sayyidul Istighfar)",
      "hi": "सैय्यदुल अस्तग़फ़ार (माफ़ी की सबसे बड़ी दुआ)",
      "ur": "सैय्यदुल अस्तग़फ़ार (माफ़ी की सबसे बड़ी दुआ)"
    },
    "tm": {
      "en": "Once in the morning (after Fajr) and once in the evening (after Asr/Maghrib).",
      "hi": "Once in the morning (after Fajr) and once in the evening (after Asr/Maghrib).",
      "ur": "Once in the morning (after Fajr) and once in the evening (after Asr/Maghrib)."
    },
    "how": {
      "en": "Count: 1 time morning, 1 time evening.  Recite with firm conviction in its meaning. Virtue & Benefit: The Prophet ﷺ said: 'Whoever says it during the day with firm faith and dies before evening will be from the people of Paradise, and whoever says it at night with firm faith and dies before morning will be from the people of Paradise.'",
      "hi": "तादाद: 1 time morning, 1 time evening। Recite with firm conviction in its meaning. फ़ज़ीलत: The Prophet ﷺ said: 'Whoever says it during the day with firm faith and dies before evening will be from the people of Paradise, and whoever says it at night with firm faith and dies before morning will be from the people of Paradise.'",
      "ur": "تعداد: 1 time morning, 1 time evening। Recite with firm conviction in its meaning. فضیلت: The Prophet ﷺ said: 'Whoever says it during the day with firm faith and dies before evening will be from the people of Paradise, and whoever says it at night with firm faith and dies before morning will be from the people of Paradise.'"
    },
    "ref": "Sahih al-Bukhari (6306) | Sahih",
    "active": true
  },
  {
