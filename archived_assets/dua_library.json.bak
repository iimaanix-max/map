  {
    "id": "dua_v_evening_amsayna",
    "cat": "evening",
    "subcat": "evening_adhkar",
    "allCats": [
      "daily_life",
      "evening",
      "morning"
    ],
    "ar": "أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ، لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ",
    "lo": {
      "en": "Amsayna wa amsal-mulku lillah, wal-hamdu lillah, la ilaha illallahu wahdahu la sharika lah, lahul-mulku wa lahul-hamdu wa Huwa 'ala kulli shay'in Qadir",
      "hi": "अमसयना व अम्सल-मुल्कु लिल्लाह, वल-हम्दु लिल्लाह, ला इलाहा इल्लल्लाहु वह्दहू ला शरीका लह, लहुल-मुल्कु व लहुल-हम्दु वहुवा अला कुल्लि शैइन क़दीर",
      "ur": "أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ، وَالْحَمْدُ لِلَّهِ"
    },
    "me": {
      "en": "We have reached the evening and the kingdom belongs to Allah, and all praise is for Allah. There is no true deity except Allah alone, without partner. His is the sovereignty and His is the praise, and He has power over all things.",
      "hi": "हमने शाम की और सारी बादशाही अल्लाह की मिलकियत रही, और तमाम तारीफ़ें अल्लाह ही के लिए हैं। अल्लाह के सिवा कोई सच्चा माबूद नहीं, वह अकेला है उसका कोई शरीक नहीं।",
      "ur": "ہم نے شام کی اور شام کے وقت سارا ملک اللہ ہی کا رہا"
    },
    "title": {
      "en": "Evening Supplication of Praise and Sovereignty",
      "hi": "शाम अल्लाह की बादशाही व बड़ाई का इक़रार",
      "ur": "شام کے وقت حمد و ثنا اور پناہ کی دعا"
    },
    "tm": {
      "en": "In the evening after Asr or Maghrib.",
      "hi": "शाम के वक़्त असर या मग़रिब की नमाज़ के बाद पढ़ें।",
      "ur": "شام کے وقت عصر یا مغرب کے بعد پڑھیں۔"
    },
    "how": {
      "en": "Recite once every evening.",
      "hi": "हर शाम एक बार पाबंदी से पढ़ें। (सह़ीह़ मुस्लिम 2723)",
      "ur": "ہر شام ایک بار پڑھیں۔"
    },
    "ref": "Sahih Muslim (2723) | Sahih",
    "active": true
  },
  {
    "id": "dua_v_fever_cure",
    "cat": "shifa",
    "subcat": "fever_relief",
    "allCats": [
      "self_control",
      "shifa",
      "daily_life",
      "health_shifa",
      "temptation",
      "zina"
    ],
    "ar": "بِسْمِ اللَّهِ الْكَبِيرِ، أَعُوذُ بِاللَّهِ الْعَظِيمِ مِنْ شَرِّ كُلِّ عِرْقٍ نَعَّارٍ، وَمِنْ شَرِّ حَرِّ النَّارِ",
    "lo": {
      "en": "Bismillahil-Kabir, a'udhu billahil-'Azim min sharri kulli 'irqin na''ar, wa min sharri harrin-nar",
      "hi": "बिस्मिल्लाहिल-कबीर, अऊज़ु बिल्लाहिल-अज़ीम मिन शर्रि कुल्लि इरक़िन नअ्आर, व मिन शर्रि हर्रिन-नार",
      "ur": "بسم الله الكبير، أعوذ بالله العظيم من شر كل عرق نعار، ومن شر حر النار"
    },
    "me": {
      "en": "In the name of Allah the Great, I seek refuge in Allah the Tremendous from the evil of every gushing vein, and from the evil of the heat of the Fire.",
      "hi": "अल्लाह के नाम से जो बहुत बड़ा है, मैं अज़ीम अल्लाह की पनाह मांगता हूँ हर भड़कती हुई रग के शर से, और आग (बुख़ार) की तपिश के शर से।",
      "ur": "اللہ کے نام سے جو سب سے بڑا ہے، میں عظمت والے اللہ کی پناہ مانگتا ہوں ہر جوش مارنے والی رگ کے شر سے اور آگ کی گرمی کے شر سے۔"
    },
    "title": {
      "en": "Dua for High Fever and Burning Pain",
      "hi": "बुख़ार व तेज़ तपिश से शिफ़ा की दुआ",
      "ur": "بخار اور تیز حرارت سے شفا کی دعا"
    },
    "tm": {
      "en": "When suffering from fever, high body temperature, or throbbing pain.",
      "hi": "जब तेज़ बुख़ार, बदन तपने या नसों में दर्द हो तब पढ़ें।",
      "ur": "بخار یا رگوں میں درد کے وقت پڑھیں۔"
    },
    "how": {
      "en": "Recite and blow over the patient. (Jami at-Tirmidhi 2075)",
      "hi": "पढ़कर मरीज़ पर या अपने ऊपर दम करें। (जामे तिर्मिज़ी 2075)",
      "ur": "پڑھ کر مریض پر دم کریں۔"
    },
    "ref": "Jami' at-Tirmidhi (2075) / Sunan Ibn Majah (3526) | Hasan",
    "active": true
  },
  {
    "id": "dua_v_salawat_jumma",
    "cat": "jumma_dua",
    "subcat": "salawat_prophet",
    "allCats": [
      "jumma_dua",
      "special_dua",
      "faith_worship",
      "daily_life"
    ],
    "ar": "اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَعَلَىٰ آلِ مُحَمَّدٍ كَمَا صَلَّيْتَ عَلَىٰ إِبْرَاهِيمَ وَعَلَىٰ آلِ إِبْرَاهِيمَ إِنَّكَ حَمِيدٌ مَجِيدٌ",
    "lo": {
      "en": "Allahumma salli 'ala Muhammadin wa 'ala ali Muhammad, kama sallayta 'ala Ibrahima wa 'ala ali Ibrahima, innaka Hamidum-Majid",
      "hi": "अल्लाहुम्मा सल्लि अला मुहम्मदिंव-व अला आलि मुहम्मद, कमा सल्लैता अला इब्राहीमा व अला आलि इब्राहीम, इन्नका हमीदुम-मजीद",
      "ur": "اللہم صل علی محمد وعلی آل محمد"
    },
    "me": {
      "en": "O Allah, send prayers upon Muhammad and upon the family of Muhammad, as You sent prayers upon Ibrahim and upon the family of Ibrahim. Indeed, You are Praiseworthy and Glorious.",
      "hi": "ऐ अल्लाह! रहमत और दरूद नाज़िल फ़रमा हज़रत मुहम्मद ﷺ पर और उनकी आल पर, जैसा कि तूने रहमत नाज़िल फ़रमाई हज़रत इब्राहीम अलै. पर और उनकी आल पर। बेशक तू तारीफ़ के क़ाबिल और बुज़ुर्गी वाला है।",
      "ur": "اے اللہ! درود بھیج محمد ﷺ پر اور آل محمد پر"
    },
